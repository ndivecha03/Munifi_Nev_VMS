# Munifi local environment template.
# Copy to `.env` and fill in. NEVER commit `.env` (it's gitignored).
#
# Supabase credentials live here for local migration scripts. The
# production deploy reads the same names from Vercel env vars.

# Project URL — safe to commit; appears in client code anyway
SUPABASE_URL=https://your-project-ref.supabase.co

# anon key — safe in browser code (RLS protects what it can read)
SUPABASE_ANON_KEY=eyJhbGc...

# service_role key — NEVER COMMIT, NEVER PASTE INTO CHAT
# Bypasses RLS. Required for the migration script + audit writes.
# Stored in Vercel env vars for the production /api routes.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# Reuse from existing setup
RESEND_API_KEY=re_...
DEMO_MODE=true
DEMO_REDIRECT_EMAIL=nddivecha@dons.usfca.edu
ANTHROPIC_MODEL=claude-sonnet-4-5
